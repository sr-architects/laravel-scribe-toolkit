{
    "name": "sr-architects/laravel-scribe-toolkit",
    "description": "Enterprise API Documentation Governance Toolkit for Laravel Scribe",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Noon",
            "email": "noon.ruamsuk@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "knuckleswtf/scribe": "^5.10",
        "symfony/yaml": "^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9|^3.0",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "SrArchitects\\ScribeToolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SrArchitects\\ScribeToolkit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --no-coverage",
        "test:coverage": "phpunit --coverage-text --coverage-html=coverage/html",
        "test:ci": "phpunit --coverage-clover=coverage/clover.xml",
        "analyse": "phpstan analyse --memory-limit=512M",
        "ci": [
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "SrArchitects\\ScribeToolkit\\ScribeToolkitServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
