{
    "name": "sr-architects/laravel-scribe-toolkit",
    "description": "Enterprise API Documentation Governance Toolkit for Laravel Scribe",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Noon",
            "email": "noon.ruamsuk@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "knuckleswtf/scribe": "^5.10",
        "symfony/yaml": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "SrArchitects\\ScribeToolkit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SrArchitects\\ScribeToolkit\\ScribeToolkitServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
